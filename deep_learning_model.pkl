import pandas as pd
import numpy as np
import os
from sklearn.preprocessing import StandardScaler, LabelEncoder
from sklearn.ensemble import RandomForestClassifier

def run_data_pipeline():
    print("--- Phase 1: Data Loading & Cleaning ---")
    files = ['SpotifyAudioFeaturesApril2019.csv', 'SpotifyAudioFeaturesNov2018.csv']
    dfs = []
    for f in files:
        if os.path.exists(f):
            dfs.append(pd.read_csv(f))
    
    if not dfs:
        print("Error: No data found.")
        return

    df = pd.concat(dfs).drop_duplicates(subset=['track_id']).reset_index(drop=True)
    
    # Handling missing values
    # In our prev analysis, only 1 track_name was missing. We drop rows with missing essential features.
    print(f"Initial shape: {df.shape}")
    df = df.dropna(subset=['track_name', 'energy', 'valence', 'popularity']).reset_index(drop=True)
    print(f"After dropping missing names/essential features: {df.shape}")

    print("\n--- Phase 2: Feature Engineering & Creation ---")
    
    # 1. Encoding Categorical Variables
    # Mode is already binary 0/1. 
    # Key (0-11) is already numerical representing notes, but we treat it as ordinal/categorical.
    # Time_signature (3, 4, 5) is categorical.
    le = LabelEncoder()
    df['key_encoded'] = le.fit_transform(df['key'])
    df['time_sig_encoded'] = le.fit_transform(df['time_signature'])

    # 2. Feature Creation (Derived Features)
    # Duration in minutes instead of ms
    df['duration_min'] = df['duration_ms'] / 60000
    
    # Energy Density (Energy per second of song)
    df['energy_density'] = df['energy'] / (df['duration_ms'] / 1000)
    
    # Mood Complexity (Interaction between Valence and Danceability)
    df['mood_complexity'] = df['valence'] * df['danceability']

    # 3. Feature Selection & Target Definition
    # Target: High Energy (Binary)
    df['target'] = (df['energy'] > 0.5).astype(int)

    # 4. Feature Selection based on Correlation with Target
    numeric_df = df.select_dtypes(include=[np.number])
    correlations = numeric_df.corr()['target'].sort_values(ascending=False)
    print("\nFeature Correlation with Target (Energy > 0.5):")
    print(correlations.head(10))

    # Selection for model: We exclude the direct 'energy' source and obvious duplicates
    features_to_use = [
        'acousticness', 'danceability', 'duration_min', 'instrumentalness', 
        'liveness', 'loudness', 'speechiness', 'tempo', 'valence', 
        'key_encoded', 'time_sig_encoded', 'mood_complexity'
    ]
    
    X = df[features_to_use]
    y = df['target']

    # 5. Feature Scaling (Standardization)
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(X)
    X_scaled_df = pd.DataFrame(X_scaled, columns=features_to_use)

    # Save processed data
    processed_df = pd.concat([X_scaled_df, y], axis=1)
    processed_df.to_csv('processed_dataset.csv', index=False)
    print(f"\n--- Phase 3: Dataset Saved ---")
    print(f"Processed dataset saved to 'processed_dataset.csv' with {len(features_to_use)} features.")
    
    # Justification (Printing for report)
    print("\nFeature Justification:")
    print("- 'loudness': Highly correlated with energy in audio production.")
    print("- 'acousticness': Negative correlation expected (acoustic tracks are usually lower energy).")
    print("- 'mood_complexity': Captures the interplay between danceability and mood.")
    print("- 'key_encoded': Harmonic structure affects listener energy perception.")

    return features_to_use

if __name__ == "__main__":
    run_data_pipeline()
